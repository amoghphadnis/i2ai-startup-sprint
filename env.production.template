# Production Environment Variables for Cashfree Payment System
# Copy this file to .env.production and fill in your actual values

# Environment
VITE_NODE_ENV=production

# Cashfree Production Credentials
# Get these from your Cashfree merchant dashboard (Production environment)
VITE_CASHFREE_CLIENT_ID=your_production_client_id_here
VITE_CASHFREE_CLIENT_SECRET=your_production_secret_key_here

# Important Notes:
# 1. Never commit .env.production to version control
# 2. Ensure HTTPS is enabled on your production domain
# 3. Configure webhook URL in Cashfree dashboard
# 4. Test thoroughly before going live
